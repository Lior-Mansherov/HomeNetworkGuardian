<Window x:Class="HomeNetworkGuardian.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Home Network Guardian 🛡️" Height="600" Width="1100"
        Background="#F5F5F5">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnStartScan" 
                    Content="🚀 Start Network Scan" 
                    Width="150" Height="35" 
                    Click="BtnStartScan_Click"
                    Background="#007ACC" Foreground="White" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent" Margin="0,5,0,0">
            <StatusBarItem>
                <Label x:Name="lblStatus" Content="Ready to protect your network." Foreground="#555"/>
            </StatusBarItem>
        </StatusBar>

        <GroupBox Header="Discovered Devices" FontWeight="Bold" Padding="5">
            <DataGrid x:Name="dgDevices" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      RowBackground="White" 
                      AlternatingRowBackground="#F9F9F9">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IP}" Width="120"/>
                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MAC}" Width="150"/>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="180"/>
                    <DataGridTextColumn Header="Device Type" Binding="{Binding DeviceType}" Width="150"/>
                    <DataGridTextColumn Header="Open Ports &amp; Services" Binding="{Binding OpenPorts}" Width="*"/>

                    <DataGridCheckBoxColumn Header="Suspicious" Binding="{Binding IsSuspicious}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>
</Window>
